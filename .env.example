# ── Connector mode ─────────────────────────────────────────────────
# Options: "clickhouse" | "api"
CONNECTOR_MODE=api

# ── Langfuse Cloud API (CONNECTOR_MODE=api) ─────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# ── ClickHouse / Self-hosted Langfuse (CONNECTOR_MODE=clickhouse) ────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Optional: override if your Langfuse project ID is known
LANGFUSE_PROJECT_ID=

# ── Dashboard defaults ───────────────────────────────────────────────
DEFAULT_LOOKBACK_DAYS=30
